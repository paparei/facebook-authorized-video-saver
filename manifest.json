{
  "manifest_version": 3,
  "name": "Facebook Authorized Video Saver",
  "version": "1.0.0",
  "description": "Save Facebook videos you are authorized to view; downloads and merges MP4 tracks locally.",
  "minimum_chrome_version": "111",
  "permissions": [
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
